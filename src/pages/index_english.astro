---
import { SITE_CONTENT } from "@configEN";
import Hero from "@components/HeroEN.astro";
import Layout from "@layouts/LayoutEN.astro";
import Experience from "@components/ExperienceEN.astro";
import Projects from "@components/ProjectsEN.astro";
import About from "@components/AboutEN.astro";

import "../styles/global.css";
---

<Layout>
  <Hero {...SITE_CONTENT.hero} />
  <Experience experience={SITE_CONTENT.experience} />
  <Projects projects={SITE_CONTENT.projects} />
  <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
</Layout>
